def is_palindrome(a):
    i, j = 0, len(a) - 1
    while i < j:
        if a[i] != a[j]:
            return False
        i += 1
        j -= 1
    return True

print(is_palindrome([1, 2, 3, 2, 1]))
print(is_palindrome([1, 2, 2, 1]))
print(is_palindrome([1, 2, 3, 4]))
print(is_palindrome([]))
print(is_palindrome([7]))
